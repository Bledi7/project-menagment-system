{
  "name": "projects-management-backend",
  "version": "3.0.0",
  "description": "Project Management System Backend - TypeScript with PostgreSQL, Drizzle ORM, and JWT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx --tsconfig tsconfig.json src/index.ts",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate:pg",
    "migrate:push": "drizzle-kit push:pg",
    "seed": "tsx src/db/seed.ts",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "_moduleAliases": {
    "@": "dist",
    "@controllers": "dist/controllers",
    "@models": "dist/models",
    "@middleware": "dist/middleware",
    "@routes": "dist/routes",
    "@socket": "dist/socket",
    "@utils": "dist/utils",
    "@db": "dist/db",
    "@dto": "dist/dto"
  },
  "keywords": [
    "project-management",
    "postgresql",
    "drizzle-orm",
    "express",
    "typescript",
    "jwt",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.1",
    "drizzle-kit": "^0.20.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.7.2",
    "zod": "^3.22.4",
    "module-alias": "^2.2.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "module-alias": "^2.2.3",
    "prettier": "^3.1.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "tsconfig-paths": "^4.2.0"
  }
}
